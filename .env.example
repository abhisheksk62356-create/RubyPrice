# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# PostgreSQL
DATABASE_URL=postgres://rubyprice:rubyprice@localhost:5432/rubyprice_development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Redis (cache + Sidekiq)
REDIS_URL=redis://localhost:6379/0

# Rails
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
APP_HOST=localhost:3000

# Crawler
CRAWLER_USER_AGENT=RubyPriceBot/1.0 (+https://rubyprice.example.com/bot)
CRAWLER_TIMEOUT_SECONDS=8
CRAWLER_MAX_RESPONSE_BYTES=3145728
