<!DOCTYPE html>
<html lang="en" class="h-full bg-white">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · RubyPrice" : "RubyPrice — Track prices. Spot better deals." %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : 'RubyPrice automatically collects product information from permitted public webpages and helps you monitor price changes over time.' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="RubyPrice">
    <meta name="mobile-web-app-capable" content="yes">
    <meta property="og:title" content="RubyPrice">
    <meta property="og:description" content="Track prices. Spot better deals.">
    <meta property="og:type" content="website">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-white font-sans text-slate-900 antialiased">
    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
