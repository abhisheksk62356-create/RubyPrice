<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · RubyPrice" : "RubyPrice" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-sans text-slate-900 antialiased" data-controller="mobile-menu">
    <%= render "shared/flash" %>

    <div class="min-h-full">
      <!-- Mobile backdrop -->
      <div data-mobile-menu-target="backdrop" data-action="click->mobile-menu#close" class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"></div>

      <!-- Sidebar -->
      <div data-mobile-menu-target="panel" class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full transform bg-white ring-1 ring-slate-200 transition-transform duration-200 lg:translate-x-0">
        <%= render "shared/sidebar" %>
      </div>

      <div class="lg:pl-64">
        <!-- Top bar (mobile only) -->
        <div class="sticky top-0 z-20 flex items-center gap-4 border-b border-slate-200 bg-white px-4 py-3 lg:hidden">
          <button type="button" data-action="click->mobile-menu#open" class="text-slate-500" aria-label="Open menu">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" /></svg>
          </button>
          <span class="text-base font-bold text-slate-900">RubyPrice</span>
        </div>

        <main class="px-4 py-8 sm:px-6 lg:px-8">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
