<% content_for :title, "Log in" %>

<main class="flex min-h-screen items-center justify-center bg-slate-50 px-6">
  <div class="w-full max-w-sm">
    <div class="mb-8 flex justify-center">
      <%= link_to root_path, class: "flex items-center gap-2" do %>
        <%= image_tag "/icon.svg", class: "h-9 w-9", alt: "" %>
        <span class="text-xl font-bold text-slate-900">RubyPrice</span>
      <% end %>
    </div>

    <div class="card p-8">
      <h1 class="text-lg font-semibold text-slate-900">Welcome back</h1>
      <p class="mt-1 text-sm text-slate-500">Log in to your account to keep tracking prices.</p>

      <%= form_with url: login_path, method: :post, class: "mt-6 space-y-5" do |f| %>
        <div>
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "form-input" %>
        </div>

        <div>
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, required: true, autocomplete: "current-password", class: "form-input" %>
        </div>

        <%= f.submit "Log in", class: "btn-primary w-full" %>
      <% end %>

      <p class="mt-6 text-center text-sm text-slate-500">
        Don't have an account?
        <%= link_to "Sign up", signup_path, class: "font-semibold text-brand-600 hover:text-brand-700" %>
      </p>
    </div>
  </div>
</main>
