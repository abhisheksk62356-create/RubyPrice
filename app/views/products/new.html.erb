<% content_for :title, "Add Product" %>

<div class="mx-auto max-w-xl">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Add Product</h1>
  <p class="mt-1 text-sm text-slate-500">Paste a link to a permitted public product page. We'll validate it and start tracking the price.</p>

  <div class="card mt-6 p-6">
    <%= form_with url: products_path, method: :post do |f| %>
      <%= f.label :url, "Product URL", class: "form-label" %>
      <%= f.url_field :url, value: @raw_url, placeholder: "https://example.com/product", required: true, autofocus: true, class: "form-input" %>
      <p class="mt-2 text-xs text-slate-500">We only crawl permitted public pages and never bypass logins, paywalls, or CAPTCHAs.</p>

      <%= f.submit "Analyze Product", class: "btn-primary mt-5 w-full" %>
    <% end %>
  </div>
</div>
