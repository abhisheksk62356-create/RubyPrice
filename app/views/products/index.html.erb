<% content_for :title, "Products" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Products</h1>
  <%= link_to "Add Product", new_product_path, class: "btn-primary" %>
</div>

<%= form_with url: products_path, method: :get, class: "mt-6 flex flex-wrap items-center gap-3" do |f| %>
  <div class="min-w-[220px] flex-1">
    <%= f.text_field :q, value: params[:q], placeholder: "Search by name or store…", class: "form-input" %>
  </div>

  <%= f.select :monitoring, [["All monitoring", ""], ["Monitoring on", "on"], ["Monitoring off", "off"]], { selected: params[:monitoring] }, class: "form-input w-auto" %>

  <%= f.select :sort, [["Newest", ""], ["Lowest price", "lowest_price"], ["Largest price drop", "largest_drop"]], { selected: params[:sort] }, class: "form-input w-auto" %>

  <%= f.submit "Filter", class: "btn-secondary" %>
<% end %>

<% if @tracked_products.empty? %>
  <%= render "shared/empty_state",
        title: "No tracked products yet.",
        body: "Add your first product to start monitoring prices.",
        cta_label: "Add Product",
        cta_path: new_product_path %>
<% else %>
  <!-- Desktop table -->
  <div class="mt-6 hidden overflow-hidden rounded-xl border border-slate-200 lg:block">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <% ["Product", "Store", "Price", "Change", "Monitoring", "Last checked", ""].each do |header| %>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= header %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% @tracked_products.each do |tracked_product| %>
          <% product = tracked_product.product %>
          <tr>
            <td class="max-w-xs truncate px-4 py-3 text-sm font-medium text-slate-900"><%= link_to product.name, product_path(product), class: "hover:text-brand-600" %></td>
            <td class="px-4 py-3 text-sm text-slate-500"><%= product.domain %></td>
            <td class="px-4 py-3 text-sm font-semibold text-slate-900">
              <%= product.current_price.present? ? number_to_currency(product.current_price, unit: currency_symbol(product.currency)) : "—" %>
            </td>
            <td class="px-4 py-3 text-sm">
              <% if product.price_change_percent.present? %>
                <span class="<%= price_change_badge_class(product) %>"><%= number_to_percentage(product.price_change_percent, precision: 1) %></span>
              <% else %>
                <span class="text-slate-400">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm">
              <span class="<%= tracked_product.monitoring_enabled? ? 'badge-green' : 'badge-slate' %>"><%= tracked_product.monitoring_enabled? ? "On" : "Off" %></span>
            </td>
            <td class="px-4 py-3 text-sm text-slate-500"><%= product.last_checked_at.present? ? time_ago_in_words(product.last_checked_at) + " ago" : "never" %></td>
            <td class="px-4 py-3 text-right text-sm">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "View", product_path(product), class: "font-medium text-brand-600 hover:text-brand-700" %>
                <%= button_to "Refresh", refresh_product_path(product), method: :post, class: "font-medium text-slate-600 hover:text-slate-900 bg-transparent p-0" %>
                <%= button_to "Delete", product_path(product), method: :delete, form: { data: { turbo_confirm: "Remove this product from your tracked list?" } }, class: "font-medium text-red-600 hover:text-red-700 bg-transparent p-0" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Mobile cards -->
  <div class="mt-6 space-y-4 lg:hidden">
    <% @tracked_products.each do |tracked_product| %>
      <% product = tracked_product.product %>
      <div class="card p-4">
        <div class="flex items-start justify-between">
          <div class="min-w-0">
            <%= link_to product.name, product_path(product), class: "block truncate text-sm font-semibold text-slate-900" %>
            <p class="text-xs text-slate-500"><%= product.domain %></p>
          </div>
          <span class="<%= tracked_product.monitoring_enabled? ? 'badge-green' : 'badge-slate' %>"><%= tracked_product.monitoring_enabled? ? "On" : "Off" %></span>
        </div>

        <div class="mt-3 flex items-center justify-between">
          <span class="text-lg font-bold text-slate-900">
            <%= product.current_price.present? ? number_to_currency(product.current_price, unit: currency_symbol(product.currency)) : "—" %>
          </span>
          <% if product.price_change_percent.present? %>
            <span class="<%= price_change_badge_class(product) %>"><%= number_to_percentage(product.price_change_percent, precision: 1) %></span>
          <% end %>
        </div>

        <div class="mt-4 flex items-center gap-4 text-sm">
          <%= link_to "View", product_path(product), class: "font-medium text-brand-600" %>
          <%= button_to "Refresh", refresh_product_path(product), method: :post, class: "font-medium text-slate-600 bg-transparent p-0" %>
          <%= button_to "Delete", product_path(product), method: :delete, form: { data: { turbo_confirm: "Remove this product from your tracked list?" } }, class: "font-medium text-red-600 bg-transparent p-0" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-8">
    <%= paginate @tracked_products %>
  </div>
<% end %>
