<%= link_to product_path(product), class: "card block overflow-hidden transition hover:shadow-md" do %>
  <div class="flex h-32 items-center justify-center bg-slate-50">
    <% if product.image_url.present? %>
      <%= image_tag product.image_url, class: "h-full w-full object-contain p-4", alt: product.name %>
    <% else %>
      <svg class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 12v-3.75c0-1.036.84-1.875 1.875-1.875h.375m-2.25 5.625V16.5c0 1.036.84 1.875 1.875 1.875h13.5c1.035 0 1.875-.84 1.875-1.875V6.75c0-1.036-.84-1.875-1.875-1.875h-1.5m-9.75 0h9.75" /></svg>
    <% end %>
  </div>

  <div class="p-4">
    <p class="truncate text-sm font-semibold text-slate-900"><%= product.name %></p>
    <p class="truncate text-xs text-slate-500"><%= product.domain %></p>

    <div class="mt-3 flex items-center justify-between">
      <span class="text-lg font-bold text-slate-900">
        <%= product.current_price.present? ? number_to_currency(product.current_price, unit: currency_symbol(product.currency)) : "—" %>
      </span>

      <% if product.price_change_percent.present? %>
        <span class="<%= product.price_drop? ? 'badge-green' : 'badge-red' %>">
          <%= number_to_percentage(product.price_change_percent, precision: 1) %>
        </span>
      <% end %>
    </div>
  </div>
<% end %>
