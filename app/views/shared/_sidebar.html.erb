<div class="flex h-full flex-col">
  <div class="flex items-center gap-2 px-6 py-5">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <%= image_tag "/icon.svg", class: "h-7 w-7", alt: "" %>
      <span class="text-base font-bold text-slate-900">RubyPrice</span>
    <% end %>
  </div>

  <nav class="flex-1 space-y-1 px-3">
    <%= link_to dashboard_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(dashboard_path) ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6a2.25 2.25 0 012.25-2.25h12A2.25 2.25 0 0120.25 6v12a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18V6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5M9 21V9" /></svg>
      Dashboard
    <% end %>

    <p class="px-3 pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Products</p>

    <%= link_to products_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(products_path) ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375C2.754 3.75 2.25 4.254 2.25 4.875v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
      All Products
    <% end %>

    <%= link_to new_product_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(new_product_path) ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Add Product
    <% end %>

    <%= link_to product_groups_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(product_groups_path) ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>
      Compare Prices
    <% end %>

    <% if current_user&.admin? %>
      <p class="px-3 pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Admin</p>
      <%= link_to admin_root_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(admin_root_path) ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50'}" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Admin Dashboard
      <% end %>
    <% end %>
  </nav>

  <div class="space-y-1 border-t border-slate-200 px-3 py-4">
    <%= link_to settings_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(settings_path) ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      Settings
    <% end %>

    <div class="flex items-center gap-3 rounded-lg px-3 py-2">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-semibold text-brand-700">
        <%= current_user.email.first.upcase %>
      </div>
      <p class="min-w-0 flex-1 truncate text-sm text-slate-600"><%= current_user.email %></p>
    </div>

    <%= button_to "Logout", logout_path, method: :delete, class: "flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>
</div>
