<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      <div class="col-span-2">
        <div class="flex items-center gap-2">
          <%= image_tag "/icon.svg", class: "h-7 w-7", alt: "" %>
          <span class="text-base font-bold text-slate-900">RubyPrice</span>
        </div>
        <p class="mt-3 max-w-xs text-sm text-slate-500">Track prices. Spot better deals.</p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-900">Product</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-500">
          <li><%= link_to "Features", features_path, class: "hover:text-slate-900" %></li>
          <li><%= link_to "Dashboard", dashboard_path, class: "hover:text-slate-900" %></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-900">Company</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-500">
          <li><a href="#" class="hover:text-slate-900">About</a></li>
          <li><a href="mailto:hello@rubyprice.example.com" class="hover:text-slate-900">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-900">Legal</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-500">
          <li><a href="#" class="hover:text-slate-900">Privacy</a></li>
          <li><a href="#" class="hover:text-slate-900">Terms</a></li>
          <li><a href="https://github.com" class="hover:text-slate-900">GitHub</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-500">
      &copy; <%= Date.current.year %> RubyPrice. Built with Ruby on Rails.
    </div>
  </div>
</footer>
