<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <%= image_tag "/icon.svg", class: "h-8 w-8", alt: "" %>
      <span class="text-lg font-bold tracking-tight text-slate-900">RubyPrice</span>
    <% end %>

    <div class="hidden md:flex md:items-center md:gap-8">
      <%= link_to "Features", features_path, class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>
      <a href="#how-it-works" class="text-sm font-medium text-slate-600 hover:text-slate-900">How it works</a>
      <a href="#faq" class="text-sm font-medium text-slate-600 hover:text-slate-900">FAQ</a>
    </div>

    <div class="flex items-center gap-3">
      <% if authenticated? %>
        <%= link_to "Dashboard", dashboard_path, class: "btn-primary" %>
      <% else %>
        <%= link_to "Log in", login_path, class: "text-sm font-semibold text-slate-700 hover:text-slate-900" %>
        <%= link_to "Start Tracking", signup_path, class: "btn-primary" %>
      <% end %>
    </div>
  </nav>
</header>
