<% content_for :title, "Compare Prices" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Compare Prices</h1>
  <%= link_to "New comparison", new_product_group_path, class: "btn-primary" %>
</div>

<% if @product_groups.empty? %>
  <%= render "shared/empty_state",
        title: "No comparisons yet.",
        body: "Create a comparison to see the same product's price across Amazon, Temu, AliExpress, or any store you track, side by side.",
        cta_label: "New comparison",
        cta_path: new_product_group_path %>
<% else %>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @product_groups.each do |group| %>
      <% cheapest = group.cheapest_tracked_product %>
      <%= link_to product_group_path(group), class: "card block p-5 hover:shadow-md" do %>
        <p class="font-semibold text-slate-900"><%= group.name %></p>
        <p class="mt-1 text-sm text-slate-500"><%= pluralize(group.tracked_products.size, "listing") %></p>

        <% if cheapest && !group.mixed_currencies? %>
          <p class="mt-3 text-sm text-slate-500">
            Best price
            <span class="font-semibold text-emerald-600">
              <%= number_to_currency(cheapest.product.current_price, unit: currency_symbol(cheapest.product.currency)) %>
            </span>
            at <%= cheapest.product.domain %>
          </p>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
