<% content_for :title, @product_group.name %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <p class="text-sm text-slate-500">Comparison</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900"><%= @product_group.name %></h1>
  </div>

  <%= button_to "Delete comparison", product_group_path(@product_group), method: :delete, form: { data: { turbo_confirm: "Delete this comparison? Tracked products stay, just unlinked." } }, class: "btn-danger bg-transparent p-0" %>
</div>

<% cheapest = @product_group.cheapest_tracked_product %>

<% if @product_group.mixed_currencies? %>
  <div class="mt-6 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-600/20">
    These listings are priced in different currencies, so they aren't directly comparable without a currency conversion. Prices are shown as-is.
  </div>
<% end %>

<% if @product_group.tracked_products.empty? %>
  <%= render "shared/empty_state",
        title: "No listings in this comparison yet.",
        body: "Add one of your tracked products below to start comparing prices." %>
<% else %>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @product_group.tracked_products.includes(:product).each do |tracked_product| %>
      <% product = tracked_product.product %>
      <% is_cheapest = !@product_group.mixed_currencies? && cheapest == tracked_product %>
      <div class="card relative overflow-hidden p-5 <%= 'ring-2 ring-emerald-500' if is_cheapest %>">
        <% if is_cheapest %>
          <span class="badge-green absolute right-4 top-4">Best price</span>
        <% end %>

        <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= product.domain %></p>
        <%= link_to product.name, product_path(product), class: "mt-1 block truncate font-semibold text-slate-900 hover:text-brand-600" %>

        <p class="mt-3 text-2xl font-bold text-slate-900">
          <%= product.current_price.present? ? number_to_currency(product.current_price, unit: currency_symbol(product.currency)) : "Not priced yet" %>
        </p>

        <div class="mt-4 flex items-center justify-between text-sm">
          <%= link_to "View listing", product_path(product), class: "font-medium text-brand-600 hover:text-brand-700" %>
          <%= button_to "Remove", product_group_membership_path(@product_group, tracked_product), method: :delete, class: "font-medium text-red-600 hover:text-red-700 bg-transparent p-0" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @ungrouped_tracked_products.any? %>
  <div class="card mt-8 p-6">
    <h2 class="text-sm font-semibold text-slate-900">Add another listing to this comparison</h2>
    <%= form_with url: product_group_memberships_path(@product_group), method: :post, class: "mt-3 flex flex-wrap items-center gap-3" do %>
      <%= select_tag :tracked_product_id,
            options_from_collection_for_select(@ungrouped_tracked_products, :id, ->(tp) { "#{tp.product.name} (#{tp.product.domain})" }),
            include_blank: "Select a tracked product…", class: "form-input w-auto flex-1" %>
      <%= submit_tag "Add to comparison", class: "btn-secondary" %>
    <% end %>
  </div>
<% end %>
