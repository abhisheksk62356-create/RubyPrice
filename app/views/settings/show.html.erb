<% content_for :title, "Settings" %>

<div class="mx-auto max-w-xl">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Account settings</h1>

  <div class="card mt-6 p-6">
    <%= form_with model: current_user, url: settings_path, method: :patch, class: "space-y-5" do |f| %>
      <% if current_user.errors.any? %>
        <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700 ring-1 ring-red-600/10">
          <ul class="list-disc space-y-1 pl-5">
            <% current_user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-input" %>
      </div>

      <div>
        <%= f.label :password, "New password", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input", placeholder: "Leave blank to keep your current password" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
      </div>

      <%= f.submit "Save changes", class: "btn-primary w-full" %>
    <% end %>
  </div>

  <div class="card mt-6 p-6">
    <h2 class="text-sm font-semibold text-slate-900">API access</h2>
    <p class="mt-1 text-sm text-slate-500">Use this token to authenticate requests to the RubyPrice REST API.</p>
    <code class="mt-3 block break-all rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-700 ring-1 ring-slate-200"><%= current_user.api_token %></code>
  </div>
</div>
